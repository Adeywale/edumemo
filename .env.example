# ============================================
# EduMemo - Environment Configuration Example
# Copy this file to .env and fill in real values.
# NEVER put real credentials in this file -- it IS committed to git.
# NEVER commit your real .env file to source control.
# ============================================

# Server
PORT=3000
NODE_ENV=development
# Public base URL. On Railway set this to your deployed domain, e.g.
# https://yourapp.up.railway.app -- this is what gets embedded in
# password-reset / new-memo email links.
BASE_URL=http://localhost:3000

# Session -- use a long random string, ESPECIALLY on Railway.
SESSION_SECRET=change-this-to-a-long-random-string

# Database
# Railway: either attach a Volume (the app auto-uses RAILWAY_VOLUME_MOUNT_PATH)
# or point DATABASE_PATH at a mounted path so the SQLite file survives redeploys.
DATABASE_PATH=./database/database.sqlite

# --- Institution branding (no real credentials here, just display config) ---
INSTITUTION_NAME=Federal Poly Ilaro
INSTITUTION_SHORT_NAME=FPI

# --- SMTP / Email (Gmail requires a 16-character App Password with NO spaces;
#     generate one at https://myaccount.google.com/apppasswords) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=EduMemo

# --- Web Push (VAPID keys) ---
# Generate once with:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=paste-your-generated-public-key
VAPID_PRIVATE_KEY=paste-your-generated-private-key
VAPID_SUBJECT=mailto:you@example.com

# --- First administrator seed (used only by database/seed.js) ---
# Choose a strong password (8+ characters). This creates the first Super Admin
# on an EMPTY database; on Railway it is read from the environment variables.
SEED_ADMIN_EMAIL=admin@yourinstitution.edu
SEED_ADMIN_PASSWORD=choose-a-strong-password

